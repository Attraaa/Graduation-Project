{
  "compilerOptions": {
    "tsBuildInfoFile": "./.moti-cache/tsconfig.electron.tsbuildinfo",
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["electron"]
}
