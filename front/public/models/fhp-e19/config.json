      "psi_deg",
      "type_prob",
      "delta_raw_deg",
      "load_raw_pct",
      "scale"
    ],
    "dtype": "float32",
    "notes": {
      "pose": "MediaPipe legacy Pose landmarks 0-12 (x,y normalized, z, visibility) — never 23/24 (R16)",
      "face": "tasks-vision FaceLandmarker 478 (x,y,z normalized); zeros + face_ok=0 if absent",
      "fmat": "facialTransformationMatrixes[0].data (column-major 4x4)",
      "wh": "analysed canvas width, height (px)",
      "ref_scale": "median 'scale' output over the 5-s upright calibration frames that have a face",
      "scale": "this frame's sw_over_W / eye_over_W / tz_cm",
      "ref_pose": "element-wise median of the calibration frames' pose 0-12 (13,4)",
      "ref_face": "... of face mesh (478,3)",
      "ref_fmat": "... of the head matrix (16), column-major"
    },
    "fallback_outputs": [
      "delta_deg",
      "sigma_deg",
      "load_pct",
      "sigma_load_pct",
      "psi_deg",
      "type_prob",
      "delta_raw_deg",
      "load_raw_pct"
    ]
  },
  "delta_ref_deg": 40.0,
  "delta_ref_raw_deg": 37.84592300470709,
  "load_ref_pct": 150.0,
  "load_ref_raw_pct": 152.40908812907662,
  "load_com_ab": [
    0.1,
    0.3
  ],
