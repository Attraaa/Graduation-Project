PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=moti

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# 미니 PC의 비공개 HTTPS 총평 게이트웨이 전체 주소(/review). AWS 서버에서만 사용합니다.
MOTI_REVIEW_GATEWAY_URL=

# 이메일 인증(회원가입·이메일 변경)·아이디 찾기·비밀번호 재설정 메일을 보낼 SMTP 계정. 이 서버 파일에만 둡니다.
# Gmail: 2단계 인증을 켠 계정에서 앱 비밀번호를 만들어 공백 없이 SMTP_PASS에 넣습니다.
# HOST·USER·PASS 중 하나라도 비우면 메일 기능이 "설정 필요"로 응답해 회원가입·이메일 변경도 할 수 없고, 로그인·기록 등 나머지는 그대로 동작합니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 보내는 사람 표시. 비우면 SMTP_USER를 씁니다. 예: Moti <moti.example@gmail.com>
MAIL_FROM=

# 주변 병원 찾기(카카오 로컬 API)의 REST API 키. Kakao Developers 앱에서 카카오맵 사용 설정을 켠 뒤 발급받습니다.
# 이 서버 파일에만 둡니다. 비우면 병원 찾기만 "설정 필요"로 응답하고 나머지 기능은 그대로 동작합니다. docs/nearby-hospitals.md 참고.
KAKAO_REST_API_KEY=
