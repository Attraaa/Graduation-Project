PORT=4000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=moti

JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# AI 총평(Claude). https://platform.claude.com 에서 만든 API 키를 넣습니다.
# 비워 두면 AI 총평만 "설정 필요"로 응답하고 나머지 기능은 그대로 동작합니다.
# 키는 이 서버 파일에만 둡니다. front/.env(git에 올라가고 앱에 그대로 묶임)에는 넣지 마세요.
ANTHROPIC_API_KEY=

# 아이디 찾기·비밀번호 재설정 메일을 보낼 SMTP 계정. 이 서버 파일에만 둡니다.
# Gmail: 2단계 인증을 켠 계정에서 앱 비밀번호를 만들어 공백 없이 SMTP_PASS에 넣습니다.
# HOST·USER·PASS 중 하나라도 비우면 두 기능만 "설정 필요"로 응답하고 나머지 기능은 그대로 동작합니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 보내는 사람 표시. 비우면 SMTP_USER를 씁니다. 예: Moti <moti.example@gmail.com>
MAIL_FROM=
